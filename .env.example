# Veekay CRM server — copy to `.env` on the server and fill in real values.
# Never commit the real `.env`.

NODE_ENV=production
PORT=5050

# CRM frontend URL (Vercel) and main website URL — both are allowed by CORS
FRONTEND_URL=https://crm.veekaycabs.com
MAIN_SITE_URL=https://veekaycabs.com

# Same MongoDB database as the main Veekay Cabs server
MONGODB_URI=

# Independent from the main site's JWT secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# WhatsApp new-lead alert (same AiSensy account as the main site)
AISENSY_API_KEY=
ADMIN_MOBILE=

# Lead source webhooks — see README / setup notes
GOOGLE_ADS_WEBHOOK_KEY=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
JUSTDIAL_WEBHOOK_TOKEN=
NEODOVE_WEBHOOK_TOKEN=
